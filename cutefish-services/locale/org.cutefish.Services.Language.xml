<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.cutefish.Services.Language">
    <method name="setLanguage">
        <arg name="value" type="s" direction="in"/>
    </method>

    <method name="setPreferredLanguages">
        <arg name="value" type="as" direction="in"/>
    </method>

    <method name="setRegion">
        <arg name="value" type="s" direction="in"/>
    </method>

    <method name="setFirstWeekday">
        <arg name="value" type="i" direction="in"/>
    </method>

    <method name="setMeasurementSystem">
        <arg name="value" type="s" direction="in"/>
    </method>

    <method name="setTemperatureUnit">
        <arg name="value" type="s" direction="in"/>
    </method>

    <method name="setTwentyFourHour">
        <arg name="value" type="i" direction="in"/>
    </method>

    <property name="preferredLanguages" type="as" access="read"/>
    <property name="languageCode" type="s" access="read"/>
    <property name="environment" type="a{ss}" access="read"/>
    <property name="region" type="s" access="read"/>
    <property name="regionalPreferences" type="a{ss}" access="read"/>

    <signal name="languageChanged"></signal>
  </interface>
</node>
