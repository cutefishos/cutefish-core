<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
    "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.cutefish.Services.SoftwareUpdate">
    <!-- unknown, checking, up-to-date, available, updating, restart (installed
         in this boot; a restart finishes them) or error. -->
    <property name="state" type="s" access="read"/>
    <!-- Name, new version and summary of each pending update. -->
    <property name="updates" type="a(sss)" access="read"/>
    <!-- While updating: downloading or installing. -->
    <property name="phase" type="s" access="read"/>
    <!-- While updating: 0 to 100, or -1 while unknown. -->
    <property name="progress" type="i" access="read"/>
    <!-- While updating: whether cancel can still stop it. -->
    <property name="canCancel" type="b" access="read"/>
    <!-- In the error state: the package manager's message, which may be empty. -->
    <property name="error" type="s" access="read"/>

    <method name="check"/>
    <!-- Downloads and installs every pending update now. -->
    <method name="update"/>
    <method name="cancel"/>
    <!-- Restarts the computer through the session. -->
    <method name="restart"/>
  </interface>
</node>
