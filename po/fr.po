#: cutefish-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Calcul en cours…"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "Charge complète dans {time}"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Temps restant : {time}"

#: cutefish-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Charge complète."

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Charge suspendue à {percent} %"

#: cutefish-services/battery/battery.cpp
msgid "Not charging"
msgstr "Pas en charge"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} j"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} h"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} min"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: cutefish-services/battery/battery.cpp
msgid "now"
msgstr "à l'instant"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "il y a {time}"

#: cutefish-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Batterie faible"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Batterie très faible"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Batterie vide"

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "{percent} % de batterie restante ({time})."

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "{percent} % de batterie restante."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Enregistrez votre travail et branchez l'alimentation. L'ordinateur s'éteindra lorsque la batterie sera presque vide."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Branchez l'alimentation. L'ordinateur passera en hibernation lorsque la batterie sera presque vide."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Enregistrez votre travail et branchez l'alimentation. L'ordinateur se mettra en veille lorsque la batterie sera presque vide."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Branchez bientôt l'alimentation."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "L'ordinateur va s'éteindre. Branchez l'alimentation pour qu'il continue de fonctionner."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "L'ordinateur va passer en hibernation. Branchez l'alimentation pour qu'il continue de fonctionner."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "L'ordinateur va se mettre en veille. Branchez l'alimentation pour qu'il continue de fonctionner."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Branchez l'alimentation maintenant."

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "« {name} » a quitté de manière inattendue"

#: cutefish-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Fermer"

#: cutefish-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Rouvrir"

#: cutefish-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Raison : {reason}"

#: cutefish-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "L'application est redémarrée automatiquement."

#: cutefish-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Environnement d'exécution des applications"

#: cutefish-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Certaines applications devront peut-être être redémarrées pour que la modification prenne effet."

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Partager votre écran avec « {name} »"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Choisissez un écran ou une fenêtre. Ce qui y est affiché sera visible par l'application jusqu'à ce qu'elle arrête le partage."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Choisissez une fenêtre. Son contenu sera visible par l'application jusqu'à ce qu'elle arrête le partage."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Choisissez un écran. Tout ce qui y est affiché, y compris les autres fenêtres, sera visible par l'application jusqu'à ce qu'elle arrête le partage."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Partager"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Fenêtres"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Écrans"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Toujours autoriser cette application"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Autoriser « Une application » à contrôler cet ordinateur ?"

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Autoriser « {name} » à contrôler cet ordinateur ?"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Elle verra votre écran et utilisera le pointeur et le clavier jusqu'à ce que vous l'arrêtiez avec le bouton Arrêter de la barre d'état. Si vous utilisez vous-même le pointeur ou le clavier, elle se met en pause, et elle ne peut pas répondre aux dialogues système comme celui-ci."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Autoriser"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Annuler"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Fermeture de session annulée"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Redémarrage annulé"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Extinction annulée"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Une application l'a annulé."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Une application n'a pas quitté."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} l'a annulé."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} n'a pas quitté."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Système"

#: session/cutefish-wayland.desktop
msgid "Cutefish (Wayland)"
msgstr "Cutefish (Wayland)"

#: session/cutefish-wayland.desktop
msgid "Cutefish desktop session"
msgstr "Session de bureau Cutefish"
