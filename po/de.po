#: cutefish-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Wird berechnet …"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "Noch {time} bis vollständig geladen"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Noch {time}"

#: cutefish-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Vollständig geladen."

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Laden bei {percent} % angehalten"

#: cutefish-services/battery/battery.cpp
msgid "Not charging"
msgstr "Wird nicht geladen"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} T."

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} Std."

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} Min."

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: cutefish-services/battery/battery.cpp
msgid "now"
msgstr "jetzt"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "vor {time}"

#: cutefish-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Batterieladung gering"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Batterieladung kritisch"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Batterie leer"

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Noch {percent} % Batterieladung ({time})."

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Noch {percent} % Batterieladung."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Speichern Sie Ihre Arbeit und schließen Sie das Netzteil an. Der Computer wird ausgeschaltet, wenn die Batterie fast leer ist."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Schließen Sie das Netzteil an. Der Computer wechselt in den Tiefschlaf, wenn die Batterie fast leer ist."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Speichern Sie Ihre Arbeit und schließen Sie das Netzteil an. Der Computer wechselt in den Ruhezustand, wenn die Batterie fast leer ist."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Schließen Sie bald das Netzteil an."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Der Computer wird gleich ausgeschaltet. Schließen Sie das Netzteil an, damit er weiterläuft."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Der Computer wechselt gleich in den Tiefschlaf. Schließen Sie das Netzteil an, damit er weiterläuft."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Der Computer wechselt gleich in den Ruhezustand. Schließen Sie das Netzteil an, damit er weiterläuft."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Schließen Sie jetzt das Netzteil an."

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "„{name}“ wurde unerwartet beendet"

#: cutefish-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Schließen"

#: cutefish-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Erneut öffnen"

#: cutefish-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Grund: {reason}"

#: cutefish-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Die Anwendung wird automatisch neu gestartet."

#: cutefish-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Anwendungslaufzeit"

#: cutefish-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Einige Anwendungen müssen eventuell neu gestartet werden, damit die Änderung wirksam wird."

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Bildschirm mit „{name}“ teilen"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Wählen Sie einen Bildschirm oder ein Fenster. Was darauf zu sehen ist, sieht die Anwendung, bis sie die Freigabe beendet."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Wählen Sie ein Fenster. Seinen Inhalt sieht die Anwendung, bis sie die Freigabe beendet."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Wählen Sie einen Bildschirm. Alles, was darauf zu sehen ist, auch andere Fenster, sieht die Anwendung, bis sie die Freigabe beendet."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Teilen"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Fenster"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Bildschirme"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Diese App immer erlauben"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Soll „Eine App“ diesen Computer steuern dürfen?"

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Soll „{name}“ diesen Computer steuern dürfen?"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Die App sieht Ihren Bildschirm und verwendet Zeiger und Tastatur, bis Sie sie mit der Stopptaste in der Statusleiste anhalten. Wenn Sie selbst Zeiger oder Tastatur verwenden, pausiert die App. Systemdialoge wie diesen kann sie nicht beantworten."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Erlauben"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Abbrechen"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Abmelden abgebrochen"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Neustart abgebrochen"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Ausschalten abgebrochen"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Eine Anwendung hat den Vorgang abgebrochen."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Eine Anwendung wurde nicht beendet."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} hat den Vorgang abgebrochen."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} wurde nicht beendet."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "System"

#: session/cutefish-wayland.desktop
msgid "Cutefish (Wayland)"
msgstr "Cutefish (Wayland)"

#: session/cutefish-wayland.desktop
msgid "Cutefish desktop session"
msgstr "Cutefish-Desktopsitzung"