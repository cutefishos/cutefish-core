#: cutefish-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Calculando…"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} até a carga completa"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "{time} restantes"

#: cutefish-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Carga completa."

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Carregamento pausado em {percent}%"

#: cutefish-services/battery/battery.cpp
msgid "Not charging"
msgstr "Não está carregando"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} d"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} h"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} min"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: cutefish-services/battery/battery.cpp
msgid "now"
msgstr "agora"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "há {time}"

#: cutefish-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Bateria fraca"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Bateria criticamente fraca"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Bateria esgotada"

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "{percent}% de bateria restante ({time})."

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "{percent}% de bateria restante."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Salve seu trabalho e conecte à energia. O computador será desligado quando a bateria estiver quase esgotada."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Conecte à energia. O computador hibernará quando a bateria estiver quase esgotada."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Salve seu trabalho e conecte à energia. O computador entrará em suspensão quando a bateria estiver quase esgotada."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Conecte à energia em breve."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "O computador está prestes a ser desligado. Conecte à energia para mantê-lo funcionando."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "O computador está prestes a hibernar. Conecte à energia para mantê-lo funcionando."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "O computador está prestes a entrar em suspensão. Conecte à energia para mantê-lo funcionando."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Conecte à energia agora."

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "“{name}” foi encerrado inesperadamente"

#: cutefish-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Fechar"

#: cutefish-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Reabrir"

#: cutefish-services/crash/crashdialog.cpp
msgid "OK"
msgstr "OK"

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Motivo: {reason}"

#: cutefish-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Ele é reiniciado automaticamente."

#: cutefish-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Ambiente de execução de aplicativos"

#: cutefish-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Alguns aplicativos podem precisar ser reiniciados para que a alteração tenha efeito."

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Compartilhar sua tela com “{name}”"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Escolha uma tela ou uma janela. O que for exibido nela ficará visível para o aplicativo até que ele pare de compartilhar."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Escolha uma janela. O conteúdo dela ficará visível para o aplicativo até que ele pare de compartilhar."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Escolha uma tela. Tudo o que for exibido nela, inclusive outras janelas, ficará visível para o aplicativo até que ele pare de compartilhar."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Compartilhar"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Janelas"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Telas"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Sempre permitir este aplicativo"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Permitir que “Um aplicativo” controle este computador?"

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Permitir que “{name}” controle este computador?"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Ele verá sua tela e usará o ponteiro e o teclado até que você o interrompa com o botão Parar na barra de status. Ele pausa quando você mesmo usa o ponteiro ou o teclado e não pode responder a diálogos do sistema como este."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Permitir"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Cancelar"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Encerramento de sessão cancelado"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Reinício cancelado"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Desligamento cancelado"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Um aplicativo o cancelou."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Um aplicativo não foi encerrado."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "{name} o cancelou."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "{name} não foi encerrado."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Sistema"

#: session/cutefish-wayland.desktop
msgid "Cutefish (Wayland)"
msgstr "Cutefish (Wayland)"

#: session/cutefish-wayland.desktop
msgid "Cutefish desktop session"
msgstr "Sessão da área de trabalho Cutefish"
