#: cutefish-services/battery/battery.cpp
msgid "Calculating…"
msgstr "Вычисление…"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} until fully charged"
msgstr "{time} до полной зарядки"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} remaining"
msgstr "Осталось {time}"

#: cutefish-services/battery/battery.cpp
msgid "Fully charged."
msgstr "Полностью заряжен."

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "Charging paused at {percent}%"
msgstr "Зарядка приостановлена на {percent}%"

#: cutefish-services/battery/battery.cpp
msgid "Not charging"
msgstr "Не заряжается"

#. TRANSLATORS: days in a short battery time such as "1d 2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}d"
msgstr "{n} д"

#. TRANSLATORS: hours in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}h"
msgstr "{n} ч"

#. TRANSLATORS: minutes in a short battery time such as "2h 5m".
#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{n}m"
msgstr "{n} мин"

#. TRANSLATORS: when the battery was last fully charged, under a minute ago.
#: cutefish-services/battery/battery.cpp
msgid "now"
msgstr "только что"

#: cutefish-services/battery/battery.cpp
#, python-brace-format
msgid "{time} ago"
msgstr "{time} назад"

#: cutefish-services/battery/batterywarning.cpp
msgid "Low Battery"
msgstr "Низкий заряд аккумулятора"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Critically Low"
msgstr "Критически низкий заряд аккумулятора"

#: cutefish-services/battery/batterywarning.cpp
msgid "Battery Empty"
msgstr "Аккумулятор разряжен"

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining ({time})."
msgstr "Осталось {percent}% заряда аккумулятора ({time})."

#: cutefish-services/battery/batterywarning.cpp
#, python-brace-format
msgid "{percent}% of battery remaining."
msgstr "Осталось {percent}% заряда аккумулятора."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will shut down when the battery is nearly empty."
msgstr "Сохраните работу и подключите питание. Когда аккумулятор почти разрядится, компьютер выключится."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power. The computer will hibernate when the battery is nearly empty."
msgstr "Подключите питание. Когда аккумулятор почти разрядится, компьютер перейдет в режим гибернации."

#: cutefish-services/battery/batterywarning.cpp
msgid "Save your work and connect to power. The computer will go to sleep when the battery is nearly empty."
msgstr "Сохраните работу и подключите питание. Когда аккумулятор почти разрядится, компьютер перейдет в режим сна."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power soon."
msgstr "Подключите питание в ближайшее время."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to shut down. Connect to power to keep it running."
msgstr "Компьютер скоро выключится. Подключите питание, чтобы он продолжил работу."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to hibernate. Connect to power to keep it running."
msgstr "Компьютер скоро перейдет в режим гибернации. Подключите питание, чтобы он продолжил работу."

#: cutefish-services/battery/batterywarning.cpp
msgid "The computer is about to go to sleep. Connect to power to keep it running."
msgstr "Компьютер скоро перейдет в режим сна. Подключите питание, чтобы он продолжил работу."

#: cutefish-services/battery/batterywarning.cpp
msgid "Connect to power now."
msgstr "Немедленно подключите питание."

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "“{name}” quit unexpectedly"
msgstr "Программа «{name}» неожиданно завершилась"

#: cutefish-services/crash/crashdialog.cpp
msgid "Close"
msgstr "Закрыть"

#: cutefish-services/crash/crashdialog.cpp
msgid "Reopen"
msgstr "Открыть заново"

#: cutefish-services/crash/crashdialog.cpp
msgid "OK"
msgstr "ОК"

#: cutefish-services/crash/crashdialog.cpp
#, python-brace-format
msgid "Reason: {reason}"
msgstr "Причина: {reason}"

#: cutefish-services/crash/crashdialog.cpp
msgid "It is restarted automatically."
msgstr "Она перезапускается автоматически."

#: cutefish-services/crash/crashmanager.cpp
msgid "Application Runtime"
msgstr "Среда выполнения приложений"

#: cutefish-services/locale/language.cpp
msgid "Some applications may need to be restarted for the change to take effect."
msgstr "Чтобы изменение вступило в силу, может потребоваться перезапустить некоторые приложения."

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Share your screen with “{name}”"
msgstr "Показать экран приложению «{name}»"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display or a window. What is shown on it will be visible to the application until it stops sharing."
msgstr "Выберите дисплей или окно. Его содержимое будет видно приложению, пока оно не прекратит показ."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a window. Its contents will be visible to the application until it stops sharing."
msgstr "Выберите окно. Его содержимое будет видно приложению, пока оно не прекратит показ."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Choose a display. Everything shown on it, including other windows, will be visible to the application until it stops sharing."
msgstr "Выберите дисплей. Все, что на нем показано, включая другие окна, будет видно приложению, пока оно не прекратит показ."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Share"
msgstr "Поделиться"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Windows"
msgstr "Окна"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Displays"
msgstr "Дисплеи"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Always allow this app"
msgstr "Всегда разрешать этому приложению"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Let “An app” control this computer?"
msgstr "Разрешить приложению управлять этим компьютером?"

#: cutefish-services/permissions/permissionprompt.cpp
#, python-brace-format
msgid "Let “{name}” control this computer?"
msgstr "Разрешить приложению «{name}» управлять этим компьютером?"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "It will see your screen and use the pointer and keyboard until you stop it with the Stop button in the status bar. Using the pointer or keyboard yourself pauses it, and it cannot answer system dialogs like this one."
msgstr "Оно будет видеть ваш экран и пользоваться указателем и клавиатурой, пока вы не остановите его кнопкой остановки в строке состояния. Если вы сами воспользуетесь указателем или клавиатурой, оно приостановится. Отвечать на системные диалоги, подобные этому, оно не может."

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Allow"
msgstr "Разрешить"

#: cutefish-services/permissions/permissionprompt.cpp
msgid "Cancel"
msgstr "Отмена"

#: session/processmanager.cpp
msgid "Log out cancelled"
msgstr "Выход отменен"

#: session/processmanager.cpp
msgid "Restart cancelled"
msgstr "Перезагрузка отменена"

#: session/processmanager.cpp
msgid "Shutdown cancelled"
msgstr "Выключение отменено"

#: session/processmanager.cpp
msgid "An application cancelled it."
msgstr "Отменено приложением."

#: session/processmanager.cpp
msgid "An application did not quit."
msgstr "Приложение не завершилось."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} cancelled it."
msgstr "Отменено приложением {name}."

#: session/processmanager.cpp
#, python-brace-format
msgid "{name} did not quit."
msgstr "Приложение {name} не завершилось."

#. TRANSLATORS: the sender of a notification from the session itself.
#: session/processmanager.cpp
msgid "System"
msgstr "Система"

#: session/cutefish-wayland.desktop
msgid "Cutefish (Wayland)"
msgstr "Cutefish (Wayland)"

#: session/cutefish-wayland.desktop
msgid "Cutefish desktop session"
msgstr "Сеанс рабочего стола Cutefish"
